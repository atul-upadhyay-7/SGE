        "y": 0,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "target": "soh_by_cycle",
          "type": "timeserie",
          "datasource": "Battery PDM"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2
          },
          "unit": "percent",
          "color": {
            "mode": "palette-classic"
          }
