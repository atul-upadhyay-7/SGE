    {
      "type": "table",
      "title": "SOH Nested CV Results",
      "gridPos": {
        "x": 12,
        "y": 18,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "target": "table:soh_nested_results",
          "type": "table",
          "datasource": "Battery PDM"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Anomaly: Residual (SOH \u2013 Predicted) with Robust Bounds",
      "description": "Dashed bounds are median \u00b1 3.5 \u00d7 MAD. A point beyond the bounds is a cell-specific departure: the cycle behaved unlike any cell that was in the training set. Flagged events are overlaid as markers on the same axis, since they share it.",
      "gridPos": {
        "x": 0,
        "y": 25,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "target": "anomaly_residual_by_cycle",
          "type": "timeserie",
          "datasource": "Battery PDM"
        },
        {
          "target": "anomaly_flagged_events",
          "type": "timeserie",
          "datasource": "Battery PDM"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1.5
          },
          "unit": "percent"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Flagged \u2014 B0005"
            },
            "properties": [
              {
                "id": "custom.pointSize",
                "value": 7
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Flagged \u2014 B0006"
            },
            "properties": [
              {
                "id": "custom.pointSize",
                "value": 7
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Flagged \u2014 B0007"
            },
            "properties": [
              {
                "id": "custom.pointSize",
                "value": 7
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Flagged \u2014 B0018"
            },
            "properties": [
              {
                "id": "custom.pointSize",
                "value": 7
              }
            ]
          }
        ]
      }
    },
    {
      "type": "timeseries",
      "title": "Anomaly: Trailing Fade Rate and Knee Threshold",
      "description": "A knee is a rising fade rate that crosses the per-cell median+3\u00d7MAD threshold, i.e. acceleration rather than a single noisy cycle. Flagged events are overlaid so a knee coincides visibly with the other detectors.",
      "gridPos": {
        "x": 12,
        "y": 25,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "target": "anomaly_fade_rate_by_cycle",
          "type": "timeserie",
          "datasource": "Battery PDM"
        },
        {
          "target": "anomaly_flagged_events",
          "type": "timeserie",
          "datasource": "Battery PDM"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1.5
          },
          "unit": "percent",
          "min": 0
        }
      }
    },
    {
      "type": "table",
      "title": "Anomaly Summary (per cell)",
      "description": "How many cycles each detector flagged and where the fade-rate knee first triggered. This is the triage table: the fewest rows with the most signal.",
      "gridPos": {
        "x": 0,
        "y": 34,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "target": "table:anomaly_summary",
          "type": "table",
          "datasource": "Battery PDM"
        }
      ]
    },
    {
      "type": "table",
      "title": "Anomaly Events: 32 flagged cycles (5.0%)",
      "description": "The full event-level report. Each row explains which detector(s) fired and in which direction, so a flagged cycle states why it is flagged. The full cycle-level report lives in data/processed/anomaly_cycle_report.csv.",
      "gridPos": {
        "x": 12,
        "y": 34,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "target": "table:anomaly_events",
          "type": "table",
          "datasource": "Battery PDM"
        }
      ]
    }
  ],
  "time": {
    "from": "1970-01-01T00:00:00.000Z",
    "to": "1970-01-01T00:00:01.000Z"
  },
  "timepicker": {
    "refresh_intervals": [
      "5s",
      "10s",
      "30s",
      "1m",
      "5m",
      "15m",
      "30m",
      "1h"
    ]
  },
  "description": "SOH, RUL, capacity and anomaly views for the four NASA group-1 cells. The x axis is the cycle number, which the JSON datasource returns as the series timestamp, so Grafana reads cycle N as epoch millisecond N. The dashboard time range is therefore pinned to the first second after the epoch to cover cycles 2-614; without it Grafana defaults to the last six hours and every panel reports 'Data outside time range' with an empty plot area."
}
