{
  "title": "Battery PDM (Grafana)",
  "uid": "battery-pdm-dash",
  "tags": ["battery", "machine-learning", "pdm"],
  "timezone": "browser",
  "schemaVersion": 38,
  "panels": [
    {
      "type": "timeseries",
      "title": "SOH Degradation Over Cycles",
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 9 },
      "targets": [
        {
          "target": "soh_by_cycle",
          "type": "timeserie",
          "datasource": "Battery PDM"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2
          },
          "unit": "percent",
          "color": {
            "mode": "palette-classic"
          }
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Capacity Fade (Ah)",
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 9 },
      "targets": [
        {
          "target": "capacity_by_cycle",
          "type": "timeserie",
          "datasource": "Battery PDM"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2
          },
          "unit": "amp",
          "color": {
            "mode": "palette-classic"
          }
        }
      }
    },
    {
      "type": "timeseries",
      "title": "SOH Predicted vs Actual",
      "gridPos": { "x": 0, "y": 9, "w": 12, "h": 9 },
      "targets": [
        {
          "target": "soh_predicted_vs_actual",
          "type": "timeserie",
          "datasource": "Battery PDM"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2
          },
          "unit": "percent"
        }
      }
    },
    {
      "type": "timeseries",
      "title": "RUL Predicted vs Actual",
      "gridPos": { "x": 12, "y": 9, "w": 12, "h": 9 },
      "targets": [
        {
          "target": "rul_predicted_vs_actual",
          "type": "timeserie",
          "datasource": "Battery PDM"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2
          },
          "unit": "none"
        }
      }
    },
    {
      "type": "table",
      "title": "Model Summary",
      "gridPos": { "x": 0, "y": 18, "w": 12, "h": 7 },
      "targets": [
        {
          "target": "table:model_summary",
          "type": "table",
          "datasource": "Battery PDM"
        }
      ]
    },
    {
      "type": "table",
      "title": "SOH Nested CV Results",
      "gridPos": { "x": 12, "y": 18, "w": 12, "h": 7 },
      "targets": [
        {
          "target": "table:soh_nested_results",
          "type": "table",
          "datasource": "Battery PDM"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Anomaly: Residual (SOH – Predicted) with Robust Bounds",
      "description": "Dashed bounds are median ± 3.5 × MAD. A point beyond the bounds is a cell-specific departure: the cycle behaved unlike any cell that was in the training set. Flagged events are overlaid as markers on the same axis, since they share it.",
      "gridPos": { "x": 0, "y": 25, "w": 12, "h": 9 },
      "targets": [
        {
          "target": "anomaly_residual_by_cycle",
          "type": "timeserie",
          "datasource": "Battery PDM"
        },
        {
          "target": "anomaly_flagged_events",
          "type": "timeserie",
          "datasource": "Battery PDM"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1.5
          },
          "unit": "percent"
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Flagged — B0005" },
            "properties": [{ "id": "custom.pointSize", "value": 7 }]
          },
          { "matcher": { "id": "byName", "options": "Flagged — B0006" }, "properties": [{ "id": "custom.pointSize", "value": 7 }] },
          { "matcher": { "id": "byName", "options": "Flagged — B0007" }, "properties": [{ "id": "custom.pointSize", "value": 7 }] },
          { "matcher": { "id": "byName", "options": "Flagged — B0018" }, "properties": [{ "id": "custom.pointSize", "value": 7 }] }
        ]
      }
    },
    {
      "type": "timeseries",
      "title": "Anomaly: Trailing Fade Rate and Knee Threshold",
      "description": "A knee is a rising fade rate that crosses the per-cell median+3×MAD threshold, i.e. acceleration rather than a single noisy cycle. Flagged events are overlaid so a knee coincides visibly with the other detectors.",
      "gridPos": { "x": 12, "y": 25, "w": 12, "h": 9 },
      "targets": [
        {
          "target": "anomaly_fade_rate_by_cycle",
          "type": "timeserie",
          "datasource": "Battery PDM"
        },
        {
          "target": "anomaly_flagged_events",
          "type": "timeserie",
          "datasource": "Battery PDM"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1.5
          },
          "unit": "percent",
          "min": 0
        }
      }
    },
    {
      "type": "table",
      "title": "Anomaly Summary (per cell)",
      "description": "How many cycles each detector flagged and where the fade-rate knee first triggered. This is the triage table: the fewest rows with the most signal.",
      "gridPos": { "x": 0, "y": 34, "w": 12, "h": 7 },
      "targets": [
        {
          "target": "table:anomaly_summary",
          "type": "table",
          "datasource": "Battery PDM"
        }
      ]
    },
    {
      "type": "table",
      "title": "Anomaly Events: 32 flagged cycles (5.0%)",
      "description": "The full event-level report. Each row explains which detector(s) fired and in which direction, so a flagged cycle states why it is flagged. The full cycle-level report lives in data/processed/anomaly_cycle_report.csv.",
      "gridPos": { "x": 12, "y": 34, "w": 12, "h": 7 },
      "targets": [
        {
          "target": "table:anomaly_events",
          "type": "table",
          "datasource": "Battery PDM"
        }
      ]
    }
  ]
}
