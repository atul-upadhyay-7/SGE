{
  "title": "Battery Pack Live (3S, MQTT)",
  "uid": "battery-pack-live",
  "tags": [
    "battery",
    "pack",
    "live"
  ],
  "timezone": "browser",
  "schemaVersion": 38,
  "refresh": "5s",
  "time": {
    "from": "1970-01-01T00:00:00.000Z",
    "to": "1970-01-01T00:00:00.170Z"
  },
  "description": "Live 3-cell pack from MQTT. The x axis is the discharge number, which the JSON datasource returns as a timestamp, so discharge N reads as epoch millisecond N and the range is pinned to the first 170 ms (up to 170 discharges). Fault markers in demos are synthetic.",
  "panels": [
    {
      "type": "table",
      "title": "Pack Status",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 4
      },
      "targets": [
        {
          "target": "table:live_pack_status",
          "type": "table",
          "datasource": "Battery PDM"
        }
      ],
      "id": 1
    },
    {
      "type": "table",
      "title": "Cell Health and Cycles to Retirement (80% capacity)",
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 24,
        "h": 6
      },
      "targets": [
        {
          "target": "table:live_pack_cells",
          "type": "table",
          "datasource": "Battery PDM"
        }
      ],
      "id": 2
    },
    {
