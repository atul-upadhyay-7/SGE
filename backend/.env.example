# BMS backend configuration.
# Copy to `.env` and adjust. Never commit the populated `.env`.

# Application
BMS_ENVIRONMENT=local
BMS_LOG_LEVEL=INFO
BMS_API_PREFIX=/api/v1

# CORS: browser origins allowed to call the API (comma separated, or "*").
# The default covers the common local frontend dev servers.
BMS_CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
BMS_CORS_ALLOW_CREDENTIALS=false

# Database (host-side dev points at the compose Postgres published on 5433;
# inside the compose network the service uses postgres:5432 instead).
BMS_DATABASE_URL=postgresql+asyncpg://bms:bms@localhost:5433/bms
BMS_DB_ECHO=false
BMS_DB_POOL_SIZE=10
BMS_DB_MAX_OVERFLOW=20
# Set true only for tests (avoids pooling across per-test event loops).
BMS_DB_USE_NULLPOOL=false

# MQTT
BMS_MQTT_ENABLED=true
BMS_MQTT_HOST=localhost
BMS_MQTT_PORT=1883
BMS_MQTT_USERNAME=
BMS_MQTT_PASSWORD=
BMS_MQTT_CLIENT_ID=bms-backend
BMS_MQTT_TOPIC_PREFIX=bms
BMS_MQTT_QOS=1
BMS_MQTT_KEEPALIVE=30

# Validation ranges (FR-04) - set for the actual chemistry / hardware.
BMS_CELL_VOLTAGE_MIN_V=1.5
BMS_CELL_VOLTAGE_MAX_V=4.5
BMS_PACK_VOLTAGE_MIN_V=5.0
BMS_PACK_VOLTAGE_MAX_V=60.0
BMS_CURRENT_MIN_A=-200.0
BMS_CURRENT_MAX_A=200.0
BMS_TEMPERATURE_MIN_C=-40.0
BMS_TEMPERATURE_MAX_C=100.0
BMS_MAX_SCHEMA_VERSION=1
# "unusual but valid" cell-to-cell spread that adds a quality flag
BMS_CELL_IMBALANCE_WARN_V=0.10

# Ingestion pipeline (FR-02): bounded queue + batched writes off the MQTT path
BMS_INGEST_QUEUE_MAX=10000
BMS_INGEST_BATCH_SIZE=500
BMS_INGEST_FLUSH_INTERVAL_S=0.5

# Monitoring loop and alert rules (Phase 5). Disabled in tests so the
# background task never races a per-test event loop.
BMS_MONITOR_ENABLED=true
BMS_MONITOR_INTERVAL_S=60
# Aggregate a device's cycles/SoH in the loop when it has new samples.
BMS_AUTO_AGGREGATE=true
# A device with no sample for this long raises the "device_stale" rule.
BMS_DEVICE_STALE_AFTER_S=900
# Rule thresholds, matching scripts/make_alert_rules.py and the trained range.
BMS_ALERT_SOH_RETIRE_PCT=80.0
BMS_ALERT_TEMPERATURE_MAX_C=63.0242

# Security (Phase 6). Admin key guarding POST /devices and credential
# rotation; leave empty for local development. Set a long random value before
# exposing the API beyond a trusted network.
BMS_ADMIN_API_KEY=

# RUL / EOL prediction (Phase 7). The history window matches SMOOTH_WINDOW in
# src/rul_trajectory.py; the reference-path override points at an alternate
# models/rul_reference_curves.json.
BMS_RUL_HISTORY_WINDOW=10
BMS_RUL_REFERENCE_PATH=

# Live stream (Phase 8). SSE endpoint for dashboard push; queue-max bounds the
# per-subscriber buffer (oldest events drop under a slow reader).
BMS_STREAM_ENABLED=true
BMS_STREAM_QUEUE_MAX=256

# Grafana (CR §4.2-4.7) - consumed by the Grafana container, NOT the backend.
# Grafana is optional; the stack runs without these. Point at the same Postgres
# with a READ-ONLY role (see docker/grafana/README.md), never the backend's
# write credentials, and commit no password.
BMS_POSTGRES_HOST=postgres
BMS_POSTGRES_PORT=5432
BMS_POSTGRES_DB=bms
BMS_GRAFANA_PG_USER=bms_ro
BMS_GRAFANA_PG_PASSWORD=
# Where the provisioned bms-live dashboard JSON is mounted in the container.
BMS_GRAFANA_DASHBOARDS_PATH=/etc/grafana/provisioning/dashboards
# Optional Prometheus datasource, if one is deployed.
BMS_PROMETHEUS_URL=http://prometheus:9090
