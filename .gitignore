venv/
__pycache__/
*.pyc
.ipynb_checkpoints/
.pytest_cache/
*.mat
BMS Dataset/
data/raw/
*.db
data/*.db

# Secrets. Commit the example only; never a populated .env (PRD §6).
.env
.env.*
!.env.example

# Machine-local logs (pipeline, Grafana, the JSON API) are state,
# not source. Nothing under logs/ is tracked.
logs/

# Grafana state, when launched with the repo-local paths from
# the README (GF_PATHS_DATA=.grafana-data). This holds Grafana's
# own SQLite databases and plugin cache, which are machine state,
# not project source.
.grafana-data/

artifacts/
reports/train_report_*

# Frontend build output and dependencies are reproducible, not source.
frontend/node_modules/
frontend/dist/
frontend/*.tsbuildinfo

frontend/test-results/
frontend/playwright-report/
