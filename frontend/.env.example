# Public frontend configuration. These values are NOT secrets and are baked
# into the browser bundle at build time.

# Base URL of the FastAPI backend, including the API prefix.
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Grafana base URL and the dashboard UID embedded on the Live Monitoring page.
VITE_GRAFANA_URL=http://localhost:3000
VITE_GRAFANA_DASHBOARD_UID=bms-live
